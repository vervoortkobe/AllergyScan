<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AllergyScan.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AllergyScan.Views"
    Title="AllergyScan">

    <TabBar>
        <ShellContent
            Title="Scan"
            Icon="icon_scan.svg"
            ContentTemplate="{DataTemplate views:ScanPage}"
            Route="scan" />

        <ShellContent
            Title="History"
            Icon="icon_history.svg"
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Route="history" />

        <ShellContent
            Title="Allergies"
            Icon="icon_allergy.svg"
            ContentTemplate="{DataTemplate views:AllergiesPage}"
            Route="allergies" />

        <ShellContent
            Title="Settings"
            Icon="icon_settings.svg"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings" />
    </TabBar>
</Shell>

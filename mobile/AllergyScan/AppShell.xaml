<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AllergyScan.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:AllergyScan.Localization"
    xmlns:views="clr-namespace:AllergyScan.Views"
    Title="AllergyScan">

    <TabBar>
        <ShellContent
            Title="{loc:Translate Tab.Scan}"
            Icon="icon_scan.png"
            ContentTemplate="{DataTemplate views:ScanPage}"
            Route="scan" />

        <ShellContent
            Title="{loc:Translate Tab.History}"
            Icon="icon_history.png"
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Route="history" />

        <ShellContent
            Title="{loc:Translate Tab.Allergies}"
            Icon="icon_allergy.svg"
            ContentTemplate="{DataTemplate views:AllergiesPage}"
            Route="allergies" />

        <ShellContent
            Title="{loc:Translate Tab.Settings}"
            Icon="icon_settings.svg"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings" />
    </TabBar>
</Shell>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AllergyScan.Views.SetupPage"
             xmlns:viewModels="clr-namespace:AllergyScan.ViewModels"
             x:DataType="viewModels:SetupViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Initial Setup">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="6" Margin="0,10,0,10">
                <Label Text="🛡️ AllergyScan"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <Label Text="Welcome! Let's set up your profile"
                       FontSize="22"
                       FontAttributes="Bold" />
                <Label Text="Please choose your preferred translation language and add your allergies so AllergyScan can alert you when dangerous ingredients are detected."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <!-- Language Section -->
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1. Preferred Language"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Text="Foreign ingredient lists will be translated into this language."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <Picker ItemsSource="{Binding Languages}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedLanguage}"
                            Title="Select a language" />
                </VerticalStackLayout>
            </Border>

            <!-- Allergies Section -->
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="2. Your Allergies"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Text="Tap common allergens or type custom ingredients below:"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                    <!-- Quick suggestions -->
                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Center"
                                BindableLayout.ItemsSource="{Binding CommonSuggestions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Text="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SetupViewModel}}, Path=AddSuggestionCommand}"
                                        CommandParameter="{Binding .}"
                                        Margin="0,0,6,6"
                                        Padding="10,4"
                                        FontSize="12"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                        CornerRadius="16" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Custom input -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding CustomAllergyName}"
                               Placeholder="Add custom ingredient (e.g. walnut)"
                               ReturnCommand="{Binding AddCustomAllergyCommand}" />
                        <Button Grid.Column="1"
                                Text="Add"
                                Command="{Binding AddCustomAllergyCommand}"
                                IsEnabled="{Binding CanAddCustom}" />
                    </Grid>

                    <!-- Added Allergies list -->
                    <Label Text="Selected Allergens:"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="0,6,0,0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Allergies}" Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="No allergies selected yet. Tap suggestions above or type one in."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource Primary}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                        Padding="10,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding .}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="1"
                                                Text="✕"
                                                FontSize="12"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Gray500}"
                                                Padding="4"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SetupViewModel}}, Path=RemoveAllergyCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <VerticalStackLayout Spacing="8" Margin="0,10,0,20">
                <Button Text="Save &amp; Start Scanning"
                        Command="{Binding CompleteSetupCommand}"
                        IsEnabled="{Binding CanComplete}"
                        FontSize="16"
                        FontAttributes="Bold" />

                <Button Text="Skip for now"
                        Command="{Binding SkipCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray500}" />

                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" IsVisible="{Binding IsBusy}">
                    <ActivityIndicator IsRunning="True" WidthRequest="20" HeightRequest="20" />
                    <Label Text="{Binding StatusMessage}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

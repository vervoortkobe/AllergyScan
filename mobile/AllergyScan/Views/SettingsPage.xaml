<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AllergyScan.Views.SettingsPage"
             xmlns:viewModels="clr-namespace:AllergyScan.ViewModels"
             x:DataType="viewModels:SettingsViewModel"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Settings"
                   FontSize="26"
                   FontAttributes="Bold" />

            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Translation language"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Text="The app translates every ingredients list to this language before checking your allergies."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <Label Text="{Binding CurrentLanguageText, StringFormat='Current: {0}'}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Picker ItemsSource="{Binding Languages}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedLanguage}"
                            Title="Choose a language" />
                    <Button Text="Save language"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}" />
                    <Label Text="{Binding StatusMessage}"
                           IsVisible="{Binding HasStatusMessage}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Your Allergies"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Text="Tap common allergens or type custom ingredients below so AllergyScan can alert you when dangerous ingredients are detected."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                    <!-- Quick suggestions -->
                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Center"
                                BindableLayout.ItemsSource="{Binding CommonSuggestions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Text="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SettingsViewModel}}, Path=AddSuggestionCommand}"
                                        CommandParameter="{Binding .}"
                                        Margin="0,0,6,6"
                                        Padding="10,4"
                                        FontSize="12"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                        CornerRadius="16" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Custom input -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding CustomAllergyName}"
                               Placeholder="Add custom ingredient (e.g. walnut)"
                               ReturnCommand="{Binding AddCustomAllergyCommand}" />
                        <Button Grid.Column="1"
                                Text="Add"
                                Command="{Binding AddCustomAllergyCommand}"
                                IsEnabled="{Binding CanAddCustom}" />
                    </Grid>

                    <!-- Added Allergies list -->
                    <Label Text="Selected Allergens:"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="0,6,0,0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Allergies}" Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="No allergies selected yet. Tap suggestions above or type one in."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource Primary}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                        Padding="10,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding .}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource Primary}" />
                                        <Button Grid.Column="1"
                                                Text="✕"
                                                FontSize="12"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Gray500}"
                                                Padding="4"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SettingsViewModel}}, Path=RemoveAllergyCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

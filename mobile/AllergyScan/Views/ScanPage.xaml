<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AllergyScan.Views.ScanPage"
             xmlns:loc="clr-namespace:AllergyScan.Localization"
             xmlns:viewModels="clr-namespace:AllergyScan.ViewModels"
             x:DataType="viewModels:ScanViewModel"
             Title="{loc:Translate Scan.Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{loc:Translate Scan.Heading}"
                   FontSize="26"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="{loc:Translate Scan.Description}"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

            <Border StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    HeightRequest="260">
                <Grid>
                    <Image Source="{Binding PreviewImage}"
                           Aspect="AspectFill"
                           IsVisible="{Binding HasImage}" />

                    <VerticalStackLayout IsVisible="{Binding HasNoImage}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8">
                        <!-- MAUI converts SVG images in Resources/Images to PNG at build time. -->
                        <Image Source="icon_camera_white.png"
                               WidthRequest="56"
                               HeightRequest="56"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="{loc:Translate Scan.Camera}" />
                        <Label Text="{loc:Translate Scan.NoPhoto}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="{loc:Translate Scan.NoPhotoHint}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{loc:Translate Scan.TakePhoto}"
                        Command="{Binding TakePhotoCommand}" />
                <Button Grid.Column="1"
                        Text="{loc:Translate Scan.ChoosePhoto}"
                        Command="{Binding PickPhotoCommand}" />
            </Grid>

            <Label Text="{Binding TranslationTargetText}"
                   FontAttributes="Bold" />

            <Button Text="{loc:Translate Scan.ScanIngredients}"
                    Command="{Binding ScanCommand}"
                    IsEnabled="{Binding CanScan}" />

            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   VerticalOptions="Center" />
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            </HorizontalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasResult}"
                                 Spacing="14"
                                 Margin="0,8,0,0">

                <Border BackgroundColor="{Binding FlagBackgroundColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding FlagTitle}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{Binding FlagColor}" />
                        <Label Text="{Binding FlagDescription}"
                               TextColor="{Binding FlagColor}"
                               LineBreakMode="TailTruncation"
                               MaxLines="2" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{loc:Translate Scan.OriginalText}"
                       FontAttributes="Bold" />
                <Border StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        Padding="8">
                    <Label Text="{Binding OriginalTextPreview}"
                           FontSize="13"
                           LineBreakMode="TailTruncation"
                           MaxLines="3" />
                </Border>

                <Label Text="{Binding DetectedLanguageText}"
                       FontSize="12"
                       IsVisible="{Binding HasTranslatedText}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                <Label Text="{loc:Translate Scan.TranslatedText}"
                       FontAttributes="Bold"
                       IsVisible="{Binding HasTranslatedText}" />
                <Border IsVisible="{Binding HasTranslatedText}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                    <Label Text="{Binding TranslatedTextPreview}"
                           FontSize="13"
                           LineBreakMode="TailTruncation"
                           MaxLines="3" />
                </Border>

                <Button Text="{loc:Translate Scan.ScanAnother}"
                        Command="{Binding ResetCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

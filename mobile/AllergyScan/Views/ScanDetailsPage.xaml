<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AllergyScan.Views.ScanDetailsPage"
             xmlns:loc="clr-namespace:AllergyScan.Localization"
             xmlns:viewModels="clr-namespace:AllergyScan.ViewModels"
             x:DataType="viewModels:ScanDetailsViewModel"
             Title="{loc:Translate ScanDetails.Title}">

    <ContentPage.Resources>
        <loc:ScanFlagToTextConverter x:Key="FlagToText" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Border IsVisible="{Binding HasImage}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    HeightRequest="240">
                <Image Source="{Binding ScanImage}"
                       Aspect="AspectFill" />
            </Border>

            <Border IsVisible="{Binding HasScan}"
                    BackgroundColor="{Binding FlagBackgroundColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding FlagTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{Binding FlagColor}" />
                    <Label Text="{Binding ScannedAtText}"
                           FontSize="12"
                           TextColor="{Binding FlagColor}" />
                    <Label Text="{Binding DetectedAllergens, StringFormat='Allergens: {0}'}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{Binding FlagColor}"
                           IsVisible="{Binding HasDetectedAllergens}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:Translate ScanDetails.IngredientText}"
                   FontAttributes="Bold" />
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    Padding="8">
                <ScrollView HeightRequest="120">
                    <Label Text="{Binding EditText}"
                           FontSize="13"
                           LineBreakMode="WordWrap" />
                </ScrollView>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Translate ScanDetails.AllergenStatus}"
                           FontAttributes="Bold" />
                    <Label Text="{loc:Translate ScanDetails.AllergenStatusDescription}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </VerticalStackLayout>
                <Picker Grid.Column="1"
                        Title="{loc:Translate ScanDetails.StatusPicker}"
                        ItemsSource="{Binding AvailableFlags}"
                        SelectedItem="{Binding SelectedFlag, Mode=TwoWay}"
                        VerticalOptions="Center"
                        HorizontalOptions="End">
                    <Picker.ItemDisplayBinding>
                        <Binding Path="." Converter="{StaticResource FlagToText}" />
                    </Picker.ItemDisplayBinding>
                </Picker>
            </Grid>

            <Button Text="{loc:Translate ScanDetails.Save}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}" />

            <Button Text="{loc:Translate ScanDetails.Delete}"
                    Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding CanDelete}"
                    BackgroundColor="{StaticResource Gray600}" />

            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   VerticalOptions="Center" />
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatusMessage}"
                       FontSize="13"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

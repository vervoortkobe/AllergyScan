<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AllergyScan.Models"
             xmlns:viewModels="clr-namespace:AllergyScan.ViewModels"
             x:Class="AllergyScan.Views.AllergiesPage"
             x:DataType="viewModels:AllergiesViewModel"
             x:Name="ThisPage"
             Title="My allergies">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Your allergy profile"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Label Text="Add every ingredient you must avoid. The scanner compares each product with this list."
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

            <!-- Translation language -->
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Translation language"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Text="The app translates every ingredients list to this language before checking your allergies."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <Label Text="{Binding CurrentLanguageText, StringFormat='Current: {0}'}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Picker ItemsSource="{Binding Languages}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedLanguage}"
                            Title="Choose a language" />
                </VerticalStackLayout>
            </Border>

            <!-- Common suggestions as green bubbles -->
            <Label Text="Common allergens"
                   FontSize="15"
                   FontAttributes="Bold"
                   Margin="0,4,0,0" />
            <FlexLayout Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Center"
                        BindableLayout.ItemsSource="{Binding CommonSuggestions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Text="{Binding .}"
                                Command="{Binding BindingContext.AddSuggestionCommand, Source={x:Reference ThisPage}}"
                                CommandParameter="{Binding .}"
                                Margin="0,0,6,6"
                                Padding="10,6"
                                FontSize="12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                CornerRadius="16" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Custom input -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Entry Text="{Binding NewAllergyName}"
                       Placeholder="For example: milk, egg, peanut"
                       ReturnCommand="{Binding AddCommand}" />
                <Button Grid.Column="1"
                        Text="Add"
                        Command="{Binding AddCommand}"
                        IsEnabled="{Binding CanAdd}" />
            </Grid>

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatusMessage}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            <Label Text="{Binding CountText}"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

            <Label Text="Tap an allergy to cycle its status: contains → may contain."
                   IsVisible="{Binding HasAllergies}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 Padding="0,20"
                                 Spacing="6">
                <Label Text="No allergies yet"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Add your first allergy above."
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Allergies}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Allergy">
                        <Border StrokeShape="RoundRectangle 8"
                                StrokeThickness="1"
                                Stroke="{Binding FlagStrokeColor}"
                                BackgroundColor="{Binding FlagBackgroundColor}"
                                Padding="10,6"
                                Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.ToggleFlagCommand, Source={x:Reference ThisPage}}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Text="{Binding DisplayName}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{Binding FlagTextColor}" />
                                <Label Grid.Column="1"
                                       Text="{Binding FlagBadge}"
                                       FontSize="9"
                                       VerticalOptions="Center"
                                       Margin="6,0,0,0" />
                                <Button Grid.Column="2"
                                        Text="✕"
                                        FontSize="12"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Gray500}"
                                        Padding="4"
                                        Command="{Binding BindingContext.RemoveAllergyCommand, Source={x:Reference ThisPage}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
